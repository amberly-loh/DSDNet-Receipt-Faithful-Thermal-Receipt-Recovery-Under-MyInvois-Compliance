    "epsilon": 1e-8
  },
  "schedule": {"type": "CosineAnnealingLR", "t_max_iterations": 1000, "eta_min": 0.0000005, "warmup_iterations": 0},
  "training": {
    "total_iterations": 1000,
    "crop_height": 128,
    "crop_width": 128,
    "batch_size_per_device": 1,
    "text_crop_probability": 0.85,
    "random_horizontal_flip": true,
    "random_rotations_degrees": [0, 90, 180, 270],
    "mixed_precision": true,
    "gradient_checkpointing": false,
