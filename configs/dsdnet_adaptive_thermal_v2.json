{
  "config_version": "adaptive-thermal-development-v2-validation-only",
  "seed": 61,
  "dataset_manifest": "../../FYP datasets/External/SROIE-Malaysia/sroie_protocol_manifest.csv",
  "generation_manifest": "../artifacts/protocol_lock/generation_manifest_611_sources.jsonl",
  "partitions": {"train_sources": 430, "validation_sources": 86, "excluded_test_sources": 95},
  "network": {
    "source_commit": "8a2822e44ea1e00970ed429a8230e4116034e2f9",
    "input_channels": 1,
    "output_channels": 1,
    "stages": 8,
    "maxout_branches": 4,
    "prior_channels": 16,
