    "crease_strength": [0.025, 0.14],
    "crease_thickness": [1, 4],
    "crease_blur_sigma": [0.8, 2.8],
    "crease_shadow_offset": 4,
    "fade_probability": 0.85,
    "fade_scale_pixels": [12.0, 60.0],
    "fade_strength": [0.04, 0.28],
    "blur_probability": 0.70,
    "blur_sigma": [0.35, 1.8]
  },
  "checkpoint_selection": [
    "minimum_validation_restoration_loss",
    "maximum_validation_ssim",
    "maximum_validation_stroke_recall",
    "minimum_validation_deleted_stroke_rate",
    "minimum_validation_false_stroke_rate"
  ],
  "test_access_policy": "excluded from development and checkpoint selection",
  "thesis_reporting_policy": "method refinement; must be validated before any thesis performance claim"
