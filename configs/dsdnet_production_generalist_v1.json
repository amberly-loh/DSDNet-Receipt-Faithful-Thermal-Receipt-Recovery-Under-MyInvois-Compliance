{
  "config_version": "production-generalist-v1-post-formal-evaluation",
  "seed": 56,
  "dataset_manifest": "../../FYP datasets/External/SROIE-Malaysia/sroie_protocol_manifest.csv",
  "generation_manifest": "../artifacts/protocol_lock/generation_manifest_611_sources.jsonl",
  "partitions": {
    "train_sources": 430,
    "validation_sources": 86,
    "excluded_test_sources": 95
  },
  "network": {
    "source_commit": "8a2822e44ea1e00970ed429a8230e4116034e2f9",
    "input_channels": 1,
    "output_channels": 1,
    "stages": 8,
    "maxout_branches": 4,
    "prior_channels": 16,
    "data_channels": 16,
    "cgnet_each_stage": true,
    "padding_mode": "replicate",
    "dropout_rate": 0.0
  },
  "objective": {
    "pixel": "L1",
    "structural": "1-SSIM",
    "ssim_coefficient": 0.2,
    "stroke_gradient_coefficient": 0.15,
    "foreground_text_coefficient": 0.25
  },
  "optimizer": {
    "type": "AdamW",
    "learning_rate": 0.00001,
    "beta1": 0.9,
    "beta2": 0.999,
    "weight_decay": 0.0001,
    "epsilon": 1e-8
  },
  "schedule": {
    "type": "CosineAnnealingLR",
    "t_max_iterations": 2000,
    "eta_min": 1e-7,
    "warmup_iterations": 0
  },
  "training": {
    "total_iterations": 2000,
    "crop_height": 128,
    "crop_width": 128,
    "batch_size_per_device": 1,
    "random_horizontal_flip": true,
    "random_rotations_degrees": [0, 90, 180, 270],
    "mixed_precision": true,
    "gradient_checkpointing": false,
    "gradient_clipping": true,
    "gradient_clip_norm": 1.0,
    "checkpoint_interval": 500,
    "validation_interval": 500
  },
  "natural_receipt_augmentation": {
    "enabled": true,
    "probability": 0.9,
    "texture_amplitude": [0.01, 0.12],
    "texture_scale_pixels": [4.0, 28.0],
    "crease_probability": 0.7,
    "crease_count": [1, 3],
    "crease_strength": [0.03, 0.16],
    "crease_thickness": [1, 4],
    "crease_blur_sigma": [0.8, 2.8],
    "crease_shadow_offset": 4,
    "fade_probability": 0.65,
    "fade_scale_pixels": [15.0, 55.0],
    "fade_strength": [0.03, 0.22]
  },
  "checkpoint_selection": [
    "minimum_validation_restoration_loss",
    "maximum_validation_ssim",
    "maximum_validation_stroke_recall",
    "minimum_validation_false_stroke_rate"
  ],
  "test_access_policy": "excluded from production fine-tuning and checkpoint selection",
  "thesis_reporting_policy": "post-formal production model; must not replace frozen thesis test results"
}
