{
  "config_version": "chapter4-training-lock-v1",
  "seed": 56,
  "dataset_manifest": "../../FYP datasets/External/CORD-v2/cord_v2_manifest.csv",
  "generation_manifest": "../artifacts/controlled_degradation/generation_manifest.jsonl",
  "partitions": {"train_sources": 700, "validation_sources": 150, "test_sources": 150},
  "network": {
    "source_commit": "8a2822e44ea1e00970ed429a8230e4116034e2f9",
    "input_channels": 1,
    "output_channels": 1,
    "stages": 8,
    "maxout_branches": 4,
    "cgnet_each_stage": true,
    "padding_mode": "replicate",
    "dropout_rate": 0.0
  },
  "objective": {"pixel": "L1", "structural": "1-SSIM", "ssim_coefficient": 0.2},
  "optimizer": {"type": "AdamW", "learning_rate": 0.0001, "beta1": 0.9, "beta2": 0.999, "weight_decay": 0.0001, "epsilon": 1e-8},
  "schedule": {"type": "CosineAnnealingLR", "t_max_iterations": 1000000, "eta_min": 1e-7, "warmup_iterations": 0},
  "training": {
    "total_iterations": 1000000,
    "crop_height": 128,
    "crop_width": 128,
    "batch_size_per_device": 1,
    "random_horizontal_flip": true,
    "random_rotations_degrees": [0, 90, 180, 270],
    "mixed_precision": false,
    "gradient_clipping": false,
    "checkpoint_interval": 5000,
    "validation_interval": 5000
  },
  "checkpoint_selection": ["minimum_validation_restoration_loss", "maximum_validation_ssim", "earliest_iteration"],
  "test_access_policy": "read-only after all training, checkpoint, support, calibration and threshold choices are complete"
}
