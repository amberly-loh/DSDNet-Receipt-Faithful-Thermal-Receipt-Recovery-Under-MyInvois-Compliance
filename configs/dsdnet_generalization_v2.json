{
  "config_version": "generalization-development-v2",
  "seed": 56,
  "dataset_manifest": "../../FYP datasets/External/SROIE-Malaysia/sroie_protocol_manifest.csv",
  "generation_manifest": "../artifacts/controlled_degradation_sroie/generation_manifest.jsonl",
  "partitions": {"train_sources": 691, "validation_sources": 148, "test_sources": 148},
  "network": {
    "source_commit": "8a2822e44ea1e00970ed429a8230e4116034e2f9",
    "input_channels": 1,
    "output_channels": 1,
    "stages": 8,
    "maxout_branches": 4,
    "prior_channels": 16,
    "data_channels": 16,
    "cgnet_each_stage": true,
    "padding_mode": "replicate",
    "dropout_rate": 0.0
  },
  "objective": {
    "pixel": "L1",
    "structural": "1-SSIM",
    "ssim_coefficient": 0.20,
    "stroke_gradient_coefficient": 0.18,
    "foreground_text_coefficient": 0.32
  },
  "optimizer": {
    "type": "AdamW",
    "learning_rate": 0.000025,
    "beta1": 0.9,
    "beta2": 0.999,
    "weight_decay": 0.0001,
    "epsilon": 1e-8
  },
  "schedule": {
    "type": "CosineAnnealingLR",
    "t_max_iterations": 5000,
    "eta_min": 0.000001,
    "warmup_iterations": 0
  },
  "training": {
    "total_iterations": 5000,
    "crop_height": 128,
    "crop_width": 128,
    "batch_size_per_device": 1,
    "text_crop_probability": 0.78,
    "random_horizontal_flip": true,
    "random_rotations_degrees": [0, 90, 180, 270],
    "mixed_precision": true,
    "gradient_checkpointing": false,
    "gradient_clipping": true,
    "gradient_clip_norm": 1.0,
    "checkpoint_interval": 250,
    "validation_interval": 250
  },
  "natural_receipt_augmentation": {
    "enabled": true,
    "probability": 0.94,
    "texture_amplitude": [0.015, 0.16],
    "texture_scale_pixels": [3.0, 32.0],
    "crease_probability": 0.82,
    "crease_count": [1, 5],
    "crease_strength": [0.025, 0.22],
    "crease_thickness": [1, 7],
    "crease_blur_sigma": [0.7, 3.8],
    "crease_shadow_offset": 7,
    "fade_probability": 0.78,
    "fade_scale_pixels": [10.0, 80.0],
    "fade_strength": [0.03, 0.30],
    "blur_probability": 0.55,
    "blur_sigma": [0.25, 1.8]
  },
  "checkpoint_selection": [
    "minimum_validation_restoration_loss",
    "maximum_validation_ssim",
    "maximum_stroke_recall",
    "minimum_false_stroke_rate"
  ],
  "test_access_policy": "test remains sealed until checkpoint and thresholds are selected on validation and natural holdouts"
}
