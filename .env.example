GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5055/auth/google/callback
RECEIPT_HOST=127.0.0.1
RECEIPT_PORT=5055
RECEIPT_THREADS=4
# Set to 1 only when an HTTPS reverse proxy terminates TLS for the app.
RECEIPT_HTTPS=0
